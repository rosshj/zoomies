{
  "name": "zoomies",
  "version": "0.1.0",
  "description": "Cat kart racing — a three.js web game with accelerometer steering.",
  "type": "module",
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "dev": "npx --yes serve -l 8080 .",
    "build:web": "node tools/build-web.mjs",
    "format": "prettier --write \"src/**/*.js\" \"tools/**/*.mjs\" \"*.js\" \"desktop/*.cjs\" \"plugins/audio-session/**/*.{js,cjs,mjs}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tools/**/*.mjs\" \"*.js\" \"desktop/*.cjs\" \"plugins/audio-session/**/*.{js,cjs,mjs}\"",
    "cap:sync": "npm run build:web && npx cap sync",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "check": "node tools/headless-check.mjs",
    "check:offline": "node tools/offline-check.mjs",
    "check:gamepad": "node tools/gamepad-check.mjs",
    "check:menupad": "node tools/menupad-check.mjs",
    "check:split": "node tools/split-check.mjs",
    "check:split34": "node tools/split34-check.mjs",
    "check:biome-props": "node tools/biome-props-check.mjs",
    "check:road-prop-art": "node tools/road-prop-art-check.mjs",
    "check:prop-physics": "node tools/prop-physics-check.mjs",
    "check:items": "node tools/items-check.mjs",
    "check:lives": "node tools/lives-check.mjs",
    "check:progress": "node tools/progress-check.mjs",
    "check:sim": "node tools/sim-check.mjs",
    "check:worldcfg": "node tools/worldcfg-check.mjs",
    "check:tracks": "node tools/track-audit.mjs",
    "check:tracks:random": "TRACKS=random SEEDS=6 node tools/track-audit.mjs",
    "check:art": "node tools/art-check.mjs",
    "check:accessories": "node tools/accessory-art-check.mjs",
    "check:materials": "node tools/material-check.mjs",
    "check:scenery": "node tools/scenery-check.mjs",
    "check:landscape": "node tools/landscape-check.mjs",
    "check:effects-art": "node tools/effects-art-check.mjs",
    "check:biomes": "node tools/biome-dressing-check.mjs",
    "check:terrain": "node tools/terrain-clearance-check.mjs",
    "check:tunnel-lighting": "node tools/tunnel-lighting-check.mjs",
    "check:runtime-art": "node tools/runtime-art-check.mjs",
    "check:scenery-shadows": "node tools/scenery-shadow-check.mjs",
    "check:baked-lighting": "node tools/baked-lighting-check.mjs",
    "check:living": "node tools/living-world-check.mjs",
    "check:environment-particles": "node tools/environment-particles-check.mjs",
    "check:environment-render": "node tools/environment-particles-render-check.mjs",
    "check:cat-roster": "node tools/cat-roster-data-check.mjs",
    "check:cat-roster-art": "node tools/cat-roster-check.mjs",
    "check:cat-roster-ui": "node tools/cat-roster-ui-check.mjs",
    "check:kart-roster": "node tools/kart-roster-data-check.mjs",
    "check:kart-roster-art": "node tools/kart-roster-check.mjs",
    "check:kart-roster-ui": "node tools/kart-roster-ui-check.mjs",
    "check:menus": "node tools/menu-refresh-check.mjs",
    "check:menu-state": "node tools/menu-state-check.mjs",
    "check:tilt-menus": "node tools/tilt-menu-check.mjs",
    "check:menu-consistency": "node tools/menu-consistency-check.mjs",
    "check:menu-followup": "node tools/menu-followup-check.mjs",
    "check:preview-rotation": "node tools/preview-rotation-check.mjs",
    "check:racer-details": "node tools/racer-details-check.mjs",
    "check:studio": "node tools/studio-check.mjs",
    "check:track-builder": "node tools/track-builder-check.mjs",
    "check:track-portrait": "node tools/track-portrait-check.mjs",
    "check:celebrations": "node tools/celebrations-check.mjs",
    "menu:gallery": "node tools/menu-audit.mjs",
    "gen:track-previews": "node tools/generate-track-previews.mjs",
    "menu:style-diff": "node tools/menu-style-diff.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/screen-orientation": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "zoomies-audio-session": "file:plugins/audio-session"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "playwright-core": "^1.49.0",
    "prettier": "3.9.9",
    "three": "^0.185.1"
  }
}
