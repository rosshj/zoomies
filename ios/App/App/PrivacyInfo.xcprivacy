<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Zoomies GP collects nothing and tracks nobody: saves live in
	     localStorage on the device, multiplayer rooms are joined by code with
	     no accounts, and there are no analytics/ads SDKs. The Capacitor pods
	     ship their own privacy manifests for their required-reason API use
	     (UserDefaults); this manifest covers the app target itself. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
