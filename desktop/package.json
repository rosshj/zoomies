{
  "name": "zoomies-desktop",
  "productName": "Zoomies GP",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for Zoomies GP — the Steam build.",
  "main": "main.cjs",
  "scripts": {
    "start": "npm --prefix .. run build:web && electron .",
    "start:fast": "electron .",
    "dist": "npm --prefix .. run build:web && electron-builder --config electron-builder.json"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
